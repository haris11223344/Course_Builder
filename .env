# ==============================================================================
# CourseForge Environment Configuration
# ==============================================================================

# Backend General
APP_ENV=development
PROJECT_NAME=CourseForge
SECRET_KEY=courseforge_super_secure_random_key_64_chars_minimum_length_production_ready_value!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=sqlite+aiosqlite:///./courseforge.db
# For Docker Compose:
# DATABASE_URL=mysql+asyncmy://courseforge_user:courseforge_pass@mysql:3306/courseforge?charset=utf8mb4

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://localhost:8000"]

# OAuth Google
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173

# AI & Search Providers (Optional personal overrides)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
SERPAPI_KEY=
GITHUB_TOKEN=

# Email / Mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@courseforge.local
